# Neon Postgres connection string (pooled connection recommended for serverless).
# Get it from the Neon dashboard -> your project -> Connection Details.
# Example: postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Only needed when building the Android APK (Capacitor). Set to your deployed
# API URL so the app can reach it from inside the APK. Leave empty for the
# website build. Example: VITE_API_BASE=https://finance-tracker.vercel.app
VITE_API_BASE=
